<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PingBoard.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!--
        Every NumberBox here uses SpinButtonPlacementMode="Inline". Compact renders the up/down
        buttons as a floating popup on focus, which in a horizontal panel lands on top of the field
        beside it. Inline keeps the spinner inside the control's own bounds, so it cannot overlap
        anything — at the cost of ~32px, which is why these are two per row rather than three.
    -->
    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="14" MinWidth="420">

            <TextBlock Text="Probing" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="IntervalBox" Header="Interval (ms)" Width="190"
                           Minimum="250" Maximum="3600000" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="TimeoutBox" Header="Timeout (ms)" Width="190"
                           Minimum="100" Maximum="60000" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="A timeout longer than the interval is clamped on save — otherwise a dead host would permanently skip its own probes." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="MaxConcurrentBox" Header="Max concurrent" Width="190"
                           Minimum="1" Maximum="512" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="WindowBox" Header="Rolling window" Width="190"
                           Minimum="10" Maximum="10000" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="The rolling window is how many recent probes feed the Loss %, avg/min/max and History columns. It is capped and preallocated, so it cannot grow over time." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="PayloadBox" Header="Payload (bytes)" Width="190"
                           Minimum="0" Maximum="65500" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="TtlBox" Header="TTL" Width="190"
                           Minimum="1" Maximum="255" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <TextBlock Text="Names" FontWeight="SemiBold" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="DnsTtlBox" Header="DNS cache (seconds)" Width="190"
                           Minimum="1" Maximum="86400" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="ReresolveBox" Header="Re-resolve after N fails" Width="190"
                           Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <CheckBox x:Name="PreferIPv4Check" Content="Prefer IPv4 when a name resolves to both" />

            <TextBlock Text="Alerting" FontWeight="SemiBold" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="FailuresBox" Header="Failures before 'down'" Width="190"
                           Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="SettleBox" Header="Resume settle (ms)" Width="190"
                           Minimum="0" Maximum="120000" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="Failures before 'down' is the default for every host; any target can override it from its own edit dialog. Resume settle is the pause after waking from sleep before probing restarts, so a NIC that has not finished negotiating does not produce a burst of false failures." />

            <CheckBox x:Name="NotifyCheck" Content="Notify on state change (down and recovered only)" />
            <CheckBox x:Name="LogCheck" Content="Log transitions to CSV" />
            <CheckBox x:Name="OutageLogCheck" Content="Keep an outage log that survives restarts" />
            <TextBox x:Name="LogPathBox" Header="Log file" PlaceholderText="pingboard-events.csv" />
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="A relative path is resolved next to the config file. Only transitions are logged, never individual probes — the log stays a few lines a week rather than millions." />

            <TextBlock Text="Degraded" FontWeight="SemiBold" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="DegradedLatencyBox" Header="Latency over (ms)" Width="190"
                           Minimum="0" Maximum="600000" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="DegradedLossBox" Header="Loss over (%)" Width="190"
                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="DegradedSamplesBox" Header="Averaged over N probes" Width="190"
                           Minimum="3" Maximum="1000" SpinButtonPlacementMode="Inline" />
                <CheckBox x:Name="NotifyDegradedCheck" Content="Notify when degraded"
                          VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="Zero means off, which is the default for both. A host that is still replying but slow shows as DEGRADED rather than green. These are global defaults and are usually the wrong number for any particular host — 60 ms is a broken LAN and an excellent link to another continent — so set them per target where it matters." />

            <TextBlock Text="Certificates" FontWeight="SemiBold" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="CertWarnBox" Header="Warn N days before expiry" Width="190"
                           Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="CertCheckBox" Header="Re-check every N hours" Width="190"
                           Minimum="1" Maximum="720" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="HTTPS targets only. The certificate is read on its own connection rather than on every probe, and the expiry date shows in the target's tooltip." />

            <!-- Webhook and email were configurable only by hand-editing the ini, which made a
                 shipped feature effectively invisible. Collapsed by default so the dialog does not
                 open onto a wall of fields nobody using tray notifications needs. -->
            <Expander Header="Send alerts to a webhook or by email" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">

                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="A tray notification only reaches you while you are sitting at this machine — which is when you would have noticed the board turn red anyway. These reach you when you are not." />

                    <CheckBox x:Name="WebhookCheck" Content="POST to a webhook" />
                    <TextBox x:Name="WebhookUrlBox" Header="Webhook URL"
                             PlaceholderText="https://hooks.example.com/abc" />
                    <PasswordBox x:Name="WebhookAuthBox" Header="Authorization header (optional)"
                                 PlaceholderText="Bearer …" />

                    <CheckBox x:Name="EmailCheck" Content="Send email" Margin="0,6,0,0" />
                    <TextBox x:Name="SmtpHostBox" Header="SMTP server" PlaceholderText="smtp.example.com" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="SmtpPortBox" Header="Port" Width="120"
                                   Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                        <CheckBox x:Name="StartTlsCheck" Content="Use TLS" VerticalAlignment="Bottom"
                                  Margin="0,0,0,6" />
                    </StackPanel>
                    <TextBox x:Name="SmtpUserBox" Header="Username (blank for none)" />
                    <PasswordBox x:Name="SmtpPasswordBox" Header="Password" />
                    <TextBox x:Name="EmailFromBox" Header="From" PlaceholderText="pingboard@example.com" />
                    <TextBox x:Name="EmailToBox" Header="To" PlaceholderText="you@example.com" />

                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="Credentials are encrypted with DPAPI for this Windows account, so a config file copied to another machine or into a repository carries no usable secret — and must have them re-entered there." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="MinIntervalBox" Header="Minimum seconds between alerts" Width="230"
                                   Minimum="0" Maximum="86400" SpinButtonPlacementMode="Inline" />
                        <CheckBox x:Name="NotifyRecoveryCheck" Content="Also alert on recovery"
                                  VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>

                    <CheckBox x:Name="NotifyDegradedRemoteCheck"
                              Content="Also send degraded and certificate alerts" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="Separate from the desktop toggle above. A notification here is glanceable and costs a second; these usually land in a channel somebody is on call for." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="TestAlertButton" Content="Send a test alert" Click="OnSendTestAlert" />
                        <TextBlock x:Name="TestAlertResult" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>

</ContentDialog>
