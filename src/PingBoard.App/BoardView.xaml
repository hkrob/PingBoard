<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PingBoard.App.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PingBoard.App.Controls"
    xmlns:vm="using:PingBoard.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontSize="{x:Bind vm:ColumnLayout.Instance.HeaderFontSize, Mode=OneWay}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="Auto" />   <!-- commands -->
            <RowDefinition Height="Auto" />   <!-- tab strip -->
            <RowDefinition Height="Auto" />   <!-- suspend banner -->
            <RowDefinition Height="Auto" />   <!-- column headers -->
            <RowDefinition Height="*" />      <!-- board -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Tab strip. Hidden entirely while there is only one group, so a board that does not use
             tabs looks exactly as it did before they existed. Each tab shows a live tally rather
             than a bare name: the whole point of grouping is that you are not looking at most of
             your hosts, and a tab that cannot say "2 down" would hide outages behind itself. -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{x:Bind Vm.Tabs, Mode=OneWay}"
                      Visibility="{x:Bind Vm.TabStripVisibility, Mode=OneWay}"
                      Padding="10,0,10,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TabItem">
                    <Button Click="OnSelectTab"
                            Background="Transparent"
                            Padding="10,4"
                            Opacity="{x:Bind TabOpacity, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="{x:Bind vm:ColumnLayout.Instance.ChevronFontSize, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind DisabledMarkVisibility, Mode=OneWay}" />
                            <!-- A muted group you have forgotten about is worse than one that
                                 never alerted, so the mark is permanent rather than a tooltip. -->
                            <TextBlock Text="&#xE7ED;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="{x:Bind vm:ColumnLayout.Instance.ChevronFontSize, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind MutedMarkVisibility, Mode=OneWay}" />
                            <!-- A filter narrowing what this tab shows is easy to forget about once
                                 set, so like the mute bell it stays visible rather than living only
                                 in a tooltip. -->
                            <TextBlock Text="&#xE71C;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="{x:Bind vm:ColumnLayout.Instance.ChevronFontSize, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind TagFilterMarkVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                       FontSize="12"
                                       Opacity="{x:Bind SelectionOpacity, Mode=OneWay}" />
                        </StackPanel>
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Mute alerts for this tab" Click="OnMuteTab" />
                                <MenuFlyoutItem Text="Unmute this tab" Click="OnUnmuteTab" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Enable this tab" Click="OnEnableTab" />
                                <MenuFlyoutItem Text="Disable this tab (stops probing)" Click="OnDisableTab" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Filter by tags…" Click="OnFilterTabByTags" />
                                <MenuFlyoutSeparator />
                                <!-- Both offered even on the General tab, which refuses both with an
                                     explanation on click — simpler and more honest than hiding the
                                     option and leaving the user to guess why it is not there. -->
                                <MenuFlyoutItem Text="Rename tab…" Click="OnRenameTab" />
                                <MenuFlyoutItem Text="Delete tab…" Click="OnDeleteTab" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Content is extended into the title bar, so the draggable region must be nominated
             explicitly (MainWindow calls SetTitleBar on this) or the window cannot be moved. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="14" Opacity="0.9" />
                <TextBlock Text="PingBoard" FontSize="13" FontWeight="SemiBold" />
                <!-- Filename only; the full path is one hover away. A long temp path would
                     otherwise eat the whole caption. -->
                <TextBlock Text="{x:Bind Vm.ConfigName, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind Vm.ConfigPath, Mode=OneWay}"
                           FontSize="12" Opacity="0.5"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Commands.
             Every button carries an explicit AutomationProperties.Name: their content is a glyph
             or a panel, neither of which yields an accessible name, and a ToolTip does not supply
             one either. Without these a screen reader announces nothing at all for these controls. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="10,2,10,8">
            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" Click="OnAddTarget" ToolTipService.ToolTip="Add target (Ins)"
                    AutomationProperties.Name="Add target">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" Click="OnEditTarget" ToolTipService.ToolTip="Edit selected target (F2)"
                    AutomationProperties.Name="Edit selected target">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
            </Button>
            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" Click="OnRemoveTarget" ToolTipService.ToolTip="Remove selected target (Del)"
                    AutomationProperties.Name="Remove selected target">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
            </Button>
            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" Click="OnTogglePause" ToolTipService.ToolTip="Pause or resume selected target"
                    AutomationProperties.Name="Pause or resume selected target">
                <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
            </Button>

            <AppBarSeparator />

            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" ToolTipService.ToolTip="Choose columns" AutomationProperties.Name="Choose columns">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
                    <TextBlock Text="Columns" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="ColumnsFlyout" Placement="Bottom" />
                </Button.Flyout>
            </Button>

            <!-- Mute. The glyph reflects live state rather than the last click, so an expired
                 timed mute shows as un-muted without anyone having to touch it. -->
            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" x:Name="MuteButton"
                    ToolTipService.ToolTip="{x:Bind Vm.MuteTooltip, Mode=OneWay}"
                    AutomationProperties.Name="Mute desktop notifications">
                <TextBlock Text="{x:Bind Vm.MuteGlyph, Mode=OneWay}"
                           FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Mute for 1 hour"    Click="OnMuteHour" />
                        <MenuFlyoutItem Text="Mute for 12 hours"  Click="OnMuteTwelveHours" />
                        <MenuFlyoutItem Text="Mute indefinitely"  Click="OnMuteIndefinitely" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="UnmuteItem" Text="Unmute" Click="OnUnmute" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Filter. Note what it does not do: filtered-out targets keep being probed and keep
                 alerting. A search box that quietly stopped monitoring would be a trap. -->
            <AutoSuggestBox FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" PlaceholderText="Filter name, IP or hostname"
                            Text="{x:Bind Vm.FilterText, Mode=TwoWay}"
                            QueryIcon="Find"
                            Width="220"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Filter targets" />

            <ComboBox FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" SelectedIndex="{x:Bind Vm.StatusFilterIndex, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      MinWidth="118"
                      ToolTipService.ToolTip="Filter by status"
                      AutomationProperties.Name="Filter by status">
                <ComboBoxItem Content="All statuses" />
                <ComboBoxItem Content="Problems" />
                <ComboBoxItem Content="OK" />
                <ComboBoxItem Content="Idle" />
            </ComboBox>

            <AppBarSeparator />

            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" Click="OnAbout"
                    ToolTipService.ToolTip="About PingBoard, and check for updates"
                    AutomationProperties.Name="About PingBoard">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
            </Button>

            <Button FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" ToolTipService.ToolTip="File, statistics and settings"
                    AutomationProperties.Name="File, statistics and settings">
                <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="{x:Bind vm:ColumnLayout.Instance.ToolbarFontSize, Mode=OneWay}" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Open config…" Click="OnOpenConfig">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Save config as…" Click="OnSaveConfigAs">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Outage log…" Click="OnOutageLog">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Export…" Click="OnExportCsv">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Open config folder" Click="OnOpenLogFolder">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Reset statistics for selected" Click="OnResetSelected" />
                        <MenuFlyoutItem Text="Reset all statistics" Click="OnResetAll" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Theme">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutSubItem.Icon>
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Follow Windows" GroupName="theme" Click="OnThemeSystem" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight"  Text="Light"          GroupName="theme" Click="OnThemeLight" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark"   Text="Dark"           GroupName="theme" Click="OnThemeDark" />
                            <RadioMenuFlyoutItem x:Name="ThemeMatrix" Text="Matrix"         GroupName="theme" Click="OnThemeMatrix" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Arrange columns…" Click="OnArrangeColumns">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="AutoFitColumns"
                                              Text="Auto-fit column widths"
                                              Click="OnToggleAutoFit" />
                        <MenuFlyoutItem Text="Fit columns now" Click="OnFitColumnsNow" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="CheckUpdatesOnStartup"
                                              Text="Check for updates on startup"
                                              Click="OnToggleUpdateCheck" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="StartWithWindows"
                                              Text="Start with Windows"
                                              Click="OnToggleAutostart" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Add well-known hosts…" Click="OnAddWellKnownHosts">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Settings…" Click="OnSettings">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Explains why counters have stopped moving, which is otherwise indistinguishable from
             the app having hung. -->
        <InfoBar Grid.Row="3"
                 Margin="10,0,10,8"
                 IsOpen="{x:Bind Vm.BannerVisible, Mode=OneWay}"
                 Message="{x:Bind Vm.BannerText, Mode=OneWay}"
                 Severity="Warning"
                 IsClosable="True"
                 CloseButtonClick="OnBannerClosed" />

        <!-- Column headers. Widths bind to the same shared object the rows use, which is what
             makes header/row misalignment structurally impossible. -->
        <Border Grid.Row="4"
                x:Name="HeaderBar"
                Background="{ThemeResource HeaderBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource RowSeparatorBrush}"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos0, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos1, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos2, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos3, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos4, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos5, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos6, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos7, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos8, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos9, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos10, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos11, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos12, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos13, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos14, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos15, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos16, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos17, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos18, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos19, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos20, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos21, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos22, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Each sortable header keeps its own label in Tag; the sort arrow is appended to
                     whichever one is active. Attaching the marker to the column it describes is
                     both the conventional grid behaviour and unambiguous — an indicator parked in
                     the trailing filler column reads as a stray extra header. -->
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxStatus, Mode=OneWay}"  x:Name="HdrStatus"     Tag="Status"          Text="Status"          Style="{StaticResource HeaderTextStyle}" Tapped="OnSortStatus"     Visibility="{x:Bind vm:ColumnLayout.Instance.StatusVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxName, Mode=OneWay}"  x:Name="HdrName"       Tag="Name"            Text="Name"            Style="{StaticResource HeaderTextStyle}" Tapped="OnSortName"       Visibility="{x:Bind vm:ColumnLayout.Instance.NameVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxIp, Mode=OneWay}"  x:Name="HdrIp"         Tag="IP"              Text="IP"              Style="{StaticResource HeaderTextStyle}" Tapped="OnSortIp"         Visibility="{x:Bind vm:ColumnLayout.Instance.IpVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxHostname, Mode=OneWay}"  x:Name="HdrHostname"   Tag="Hostname"        Text="Hostname"        Style="{StaticResource HeaderTextStyle}" Tapped="OnSortHostname"   Visibility="{x:Bind vm:ColumnLayout.Instance.HostnameVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLastOk, Mode=OneWay}"  x:Name="HdrLastOk"     Tag="Last OK"         Text="Last OK"         Style="{StaticResource HeaderTextStyle}" Tapped="OnSortLastOk"     Visibility="{x:Bind vm:ColumnLayout.Instance.LastOkVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLastNok, Mode=OneWay}"  x:Name="HdrLastNok"    Tag="Last NOK"        Text="Last NOK"        Style="{StaticResource HeaderTextStyle}" Tapped="OnSortLastNok"    Visibility="{x:Bind vm:ColumnLayout.Instance.LastNokVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCumulative, Mode=OneWay}"  x:Name="HdrCumulative" Tag="OK / NOK"        Text="OK / NOK"        Style="{StaticResource HeaderTextStyle}" Tapped="OnSortCumulative" Visibility="{x:Bind vm:ColumnLayout.Instance.CumulativeVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxRtt, Mode=OneWay}"  x:Name="HdrRtt"        Tag="RTT"             Text="RTT"             Style="{StaticResource HeaderTextStyle}" Tapped="OnSortRtt"        Visibility="{x:Bind vm:ColumnLayout.Instance.RttVis, Mode=OneWay}"        HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvgMinMax, Mode=OneWay}"                                               Text="avg / min / max" Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.AvgMinMaxVis, Mode=OneWay}"  HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLoss, Mode=OneWay}"  x:Name="HdrLoss"       Tag="Loss %"          Text="Loss %"          Style="{StaticResource HeaderTextStyle}" Tapped="OnSortLoss"       Visibility="{x:Bind vm:ColumnLayout.Instance.LossVis, Mode=OneWay}"       HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxJitter, Mode=OneWay}"                        Tag="Jitter"          Text="Jitter"          Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.JitterVis, Mode=OneWay}"     HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxFails, Mode=OneWay}"                                              Text="Fail"            Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.FailsVis, Mode=OneWay}"      HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSpark, Mode=OneWay}"                                              Text="History"         Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.SparkVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxUptime, Mode=OneWay}" x:Name="HdrUptime"     Tag="Uptime"          Text="Uptime"          Style="{StaticResource HeaderTextStyle}" Tapped="OnSortUptime"     Visibility="{x:Bind vm:ColumnLayout.Instance.UptimeVis, Mode=OneWay}"     HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxProbe, Mode=OneWay}"                                              Text="Probe"           Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.ProbeVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail24h, Mode=OneWay}"                        Tag="24h %"           Text="24h %"           Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.Avail24hVis, Mode=OneWay}"   HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail7d, Mode=OneWay}"                        Tag="7d %"            Text="7d %"            Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.Avail7dVis, Mode=OneWay}"    HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail30d, Mode=OneWay}"                        Tag="30d %"           Text="30d %"           Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.Avail30dVis, Mode=OneWay}"   HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCertExpiring, Mode=OneWay}"                  Tag="Expiring"        Text="Expiring"        Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.CertExpiringVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCertDays, Mode=OneWay}"                      Tag="Cert days"       Text="Cert days"       Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.CertDaysVis, Mode=OneWay}"   HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSiteName, Mode=OneWay}"                       Tag="Site"            Text="Site"            Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.SiteNameVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSiteAbbreviation, Mode=OneWay}"               Tag="Site Abbr"       Text="Site Abbr"       Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.SiteAbbreviationVis, Mode=OneWay}" />
                <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxTags, Mode=OneWay}"                            Tag="Tags"            Text="Tags"            Style="{StaticResource HeaderTextStyle}"                           Visibility="{x:Bind vm:ColumnLayout.Instance.TagsVis, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- The board. A virtualized ListView with a hand-built header rather than a third-party
             grid: WinUI 3 ships no DataGrid, and this is comfortable at the row counts a ping
             monitor actually has. -->
        <ListView Grid.Row="5"
                  x:Name="BoardList"
                  ItemsSource="{x:Bind Vm.VisibleRows, Mode=OneWay}"
                  FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"
                  PointerWheelChanged="OnBoardPointerWheel"
                  SelectionMode="Extended"
                  Padding="0,2,0,8"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  DoubleTapped="OnEditTarget">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="14,0" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetRow">
                  <StackPanel Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                    <!-- Attached to the row rather than to the ListView, so the command acts on the
                         row that was right-clicked instead of on whatever happens to be selected. -->
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Trace path now" Click="OnTraceNow">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>

                    <Grid Height="{x:Bind vm:ColumnLayout.Instance.RowHeight, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos0, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos1, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos2, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos3, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos4, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos5, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos6, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos7, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos8, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos9, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos10, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos11, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos12, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos13, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos14, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos15, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos16, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos17, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos18, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos19, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos20, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos21, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Instance.Pos22, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Glyph AND text AND colour. Never colour alone. -->
                        <StackPanel Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxStatus, Mode=OneWay}" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                    Visibility="{x:Bind vm:ColumnLayout.Instance.StatusVis, Mode=OneWay}">
                            <!-- Expands the detail panel: the latency graph, and the path trace
                                 when there is one. Always present, because every row has latency
                                 history worth plotting even when nothing has failed. -->
                            <Button Click="OnToggleDetail"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="2,0" MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Show latency graph and path trace"
                                    AutomationProperties.Name="Show latency graph and path trace">
                                <TextBlock Text="{x:Bind DetailGlyph, Mode=OneWay}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="{x:Bind vm:ColumnLayout.Instance.ChevronFontSize, Mode=OneWay}" />
                            </Button>
                            <TextBlock Text="{x:Bind StatusGlyph, Mode=OneWay}"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="{x:Bind vm:ColumnLayout.Instance.GlyphFontSize, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind ThemeKey, Mode=OneWay, Converter={StaticResource BrushKeyConverter}}" />
                            <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                       Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ThemeKey, Mode=OneWay, Converter={StaticResource BrushKeyConverter}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxName, Mode=OneWay}"  Text="{x:Bind Name}"                    Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.NameVis, Mode=OneWay}" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxIp, Mode=OneWay}"  Text="{x:Bind Ip, Mode=OneWay}"         Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.IpVis, Mode=OneWay}"         FontFamily="{StaticResource NumericFont}" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxHostname, Mode=OneWay}"  Text="{x:Bind Hostname, Mode=OneWay}"   Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.HostnameVis, Mode=OneWay}"   Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLastOk, Mode=OneWay}"  Text="{x:Bind LastOk, Mode=OneWay}"     Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.LastOkVis, Mode=OneWay}"     Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLastNok, Mode=OneWay}"  Text="{x:Bind LastNok, Mode=OneWay}"    Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.LastNokVis, Mode=OneWay}"    Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCumulative, Mode=OneWay}"  Text="{x:Bind Cumulative, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.CumulativeVis, Mode=OneWay}" FontFamily="{StaticResource NumericFont}" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxRtt, Mode=OneWay}"  Text="{x:Bind Rtt, Mode=OneWay}"        Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.RttVis, Mode=OneWay}"        Margin="0,0,10,0" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvgMinMax, Mode=OneWay}"  Text="{x:Bind AvgMinMax, Mode=OneWay}"  Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.AvgMinMaxVis, Mode=OneWay}"  Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxLoss, Mode=OneWay}"  Text="{x:Bind Loss, Mode=OneWay}"       Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.LossVis, Mode=OneWay}"       Margin="0,0,10,0" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxJitter, Mode=OneWay}" Text="{x:Bind Jitter, Mode=OneWay}"     Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.JitterVis, Mode=OneWay}"     Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxFails, Mode=OneWay}" Text="{x:Bind Fails, Mode=OneWay}"      Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.FailsVis, Mode=OneWay}"      Margin="0,0,10,0" />

                        <controls:Sparkline Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSpark, Mode=OneWay}"
                                            Row="{x:Bind}"
                                            Version="{x:Bind HistoryVersion, Mode=OneWay}"
                                            Visibility="{x:Bind vm:ColumnLayout.Instance.SparkVis, Mode=OneWay}"
                                            Height="16"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" />

                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxUptime, Mode=OneWay}" Text="{x:Bind Uptime, Mode=OneWay}"     Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.UptimeVis, Mode=OneWay}"     Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxProbe, Mode=OneWay}" Text="{x:Bind Probe, Mode=OneWay}"      Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}"    Visibility="{x:Bind vm:ColumnLayout.Instance.ProbeVis, Mode=OneWay}"      Opacity="0.7" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail24h, Mode=OneWay}" Text="{x:Bind Avail24h, Mode=OneWay}"   Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.Avail24hVis, Mode=OneWay}"   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail7d, Mode=OneWay}" Text="{x:Bind Avail7d, Mode=OneWay}"    Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.Avail7dVis, Mode=OneWay}"    Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxAvail30d, Mode=OneWay}" Text="{x:Bind Avail30d, Mode=OneWay}"   Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.Avail30dVis, Mode=OneWay}"   Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCertExpiring, Mode=OneWay}" Text="{x:Bind CertExpiring, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.CertExpiringVis, Mode=OneWay}" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxCertDays, Mode=OneWay}" Text="{x:Bind CertDays, Mode=OneWay}"     Style="{StaticResource NumericCellStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.CertDaysVis, Mode=OneWay}"   Margin="0,0,10,0" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSiteName, Mode=OneWay}" Text="{x:Bind SiteName, Mode=OneWay}"     Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.SiteNameVis, Mode=OneWay}" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxSiteAbbreviation, Mode=OneWay}" Text="{x:Bind SiteAbbreviation, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.SiteAbbreviationVis, Mode=OneWay}" Opacity="0.85" />
                        <TextBlock Grid.Column="{x:Bind vm:ColumnLayout.Instance.IdxTags, Mode=OneWay}" Text="{x:Bind Tags, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontSize="{x:Bind vm:ColumnLayout.Instance.CellFontSize, Mode=OneWay}" Visibility="{x:Bind vm:ColumnLayout.Instance.TagsVis, Mode=OneWay}" Opacity="0.85" />
                    </Grid>

                    <!-- Detail panel, nested under the host it belongs to: the latency graph, and
                         the path trace when one has been captured. Indented and monospaced so the
                         trace reads as traceroute output rather than as more board rows. -->
                    <StackPanel Visibility="{x:Bind DetailVisibility, Mode=OneWay}"
                                Margin="30,4,14,12" Spacing="2">

                        <controls:LatencyGraph Row="{x:Bind}"
                                               Version="{x:Bind HistoryVersion, Mode=OneWay}"
                                               Height="110"
                                               Margin="0,0,0,8" />

                        <StackPanel Visibility="{x:Bind TraceSectionVisibility, Mode=OneWay}" Spacing="2">
                            <TextBlock Text="{x:Bind TraceCaption, Mode=OneWay}"
                                       FontSize="11" Opacity="0.55" />
                            <TextBlock Text="{x:Bind TraceSummary, Mode=OneWay}"
                                       FontSize="12" Opacity="0.9" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind TraceHops}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   FontFamily="{StaticResource NumericFont}"
                                                   FontSize="12" Opacity="0.75" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="6"
                x:Name="StatusBar"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowSeparatorBrush}"
                Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Monospaced for the same reason the numeric columns are: a proportional
                         clock reflows the text beside it on every tick. -->
                    <TextBlock Text="{x:Bind Vm.Clock, Mode=OneWay}"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="12" Opacity="0.75" />
                    <TextBlock Text="·" FontSize="12" Opacity="0.4" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.75" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.45"
                           Text="Double-click to edit · Ins add · Del remove · closing hides to tray" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
