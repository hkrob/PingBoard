<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PingBoard.App.TargetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer>
        <StackPanel Spacing="12" MinWidth="380">

            <TextBox x:Name="AddressBox"
                     Header="IP address or hostname"
                     PlaceholderText="10.1.10.1  or  nas.local"
                     TextChanged="OnAddressChanged" />

            <TextBox x:Name="NameBox"
                     Header="Display name"
                     PlaceholderText="derived from the address" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="ProbeBox" Header="Probe" Width="140" SelectionChanged="OnProbeChanged">
                    <ComboBoxItem Content="ICMP ping" />
                    <ComboBoxItem Content="TCP connect" />
                    <ComboBoxItem Content="HTTP" />
                    <ComboBoxItem Content="HTTPS" />
                </ComboBox>

                <!-- Inline, not Compact: Compact renders the spinner as a floating popup on focus,
                     which lands on top of whatever sits beside it in a horizontal panel. -->
                <NumberBox x:Name="PortBox"
                           Header="Port"
                           Width="160"
                           Minimum="1" Maximum="65535" Value="443"
                           SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <!-- Why the TCP option exists at all: plenty of hosts and most corporate firewalls
                 drop ICMP silently, which would otherwise read as a permanently dead target. -->
            <TextBlock x:Name="ProbeHint"
                       FontSize="12"
                       Opacity="0.65"
                       TextWrapping="Wrap"
                       Text="ICMP echo. If a host silently drops ping — common on firewalled or corporate networks — switch to TCP connect against a port you know is open." />

            <!-- HTTP only. Hidden for ICMP and TCP so the dialog does not grow fields that mean
                 nothing for the probe that is actually selected. -->
            <StackPanel x:Name="HttpPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="PathBox"
                         Header="Request path"
                         PlaceholderText="/" />

                <NumberBox x:Name="ExpectStatusBox"
                           Header="Required status code (blank = any 2xx or 3xx)"
                           Width="280"
                           Minimum="100" Maximum="599"
                           SpinButtonPlacementMode="Inline"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Editable, so a tab can be created here rather than only by hand-editing the ini. -->
            <ComboBox x:Name="TabBox"
                      Header="Tab"
                      IsEditable="True"
                      Width="240"
                      HorizontalAlignment="Left"
                      PlaceholderText="General" />

            <TextBox x:Name="MaintenanceBox"
                     Header="Maintenance windows (optional)"
                     PlaceholderText="Sat 22:00-02:00, Sun 03:00-05:00" />
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="Quiet hours when this host is expected to be down. Probing carries on and the history still records what happened — only the alerts are held back, so you can see afterwards whether it came back when it should have. A host still down when the window closes alerts then. Days are optional; a window whose end is before its start runs through midnight." />

            <ToggleSwitch x:Name="EnabledSwitch" Header="Probing enabled" IsOn="True" />

            <Expander Header="Per-target overrides" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="Leave blank to inherit the global setting. Useful for a slow WAN host you want probed less often." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="IntervalBox" Header="Interval (ms)" Width="190"
                                   Minimum="250" Maximum="3600000" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="TimeoutBox" Header="Timeout (ms)" Width="190"
                                   Minimum="100" Maximum="60000" SpinButtonPlacementMode="Inline" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="PayloadBox" Header="Payload (bytes)" Width="190"
                                   Minimum="0" Maximum="65500" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="TtlBox" Header="TTL" Width="190"
                                   Minimum="1" Maximum="255" SpinButtonPlacementMode="Inline" />
                    </StackPanel>

                    <NumberBox x:Name="FailuresBox" Header="Failures before 'down'" Width="190"
                               Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline"
                               HorizontalAlignment="Left" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="How many consecutive failures before this host is declared down. Only meaningful relative to its interval — three failures at 5000 ms is fifteen seconds of silence, but at 1000 ms it is three. Raise it for a link that drops the odd packet; lower it for something that should never miss one." />
                </StackPanel>
            </Expander>

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="False" />

        </StackPanel>
    </ScrollViewer>

</ContentDialog>
